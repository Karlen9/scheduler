# Public domain name the API is served on (used by Caddy for the site block and TLS cert, and by Caddy's ACME issuance).
DOMAIN=api.example.com

# Email address passed to Caddy for ACME (Let's Encrypt) registration/expiry notices.
ACME_EMAIL=you@example.com

# Postgres password shared by the db and bot services. Generate with: openssl rand -hex 24
DB_PASSWORD=change-me-strong

# NOTE: copy this file to `.env` (not .env.example) in the real deployment —
# `docker compose` auto-loads a file literally named `.env` from the project
# directory. Generate a real DB_PASSWORD with `openssl rand -hex 24` rather
# than typing one by hand.
