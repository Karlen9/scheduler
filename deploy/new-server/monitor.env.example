# SSH target the monitor connects to in order to run `docker exec ... pg_dump`.
# On the new server this is the SAME box the backend runs on.
SSH_HOST=<NEW_IP or hostname — placeholder>

# `deploy` is the non-root user created by setup-server.sh and is a member
# of the `docker` group, so it can run `docker exec` over SSH.
SSH_USER=deploy
SSH_PORT=22

# Matches docker-compose.yml's top-level `name: scheduler`, which makes the
# db container deterministically `scheduler-db-1` — NOT the old server's
# `sport-app-db-1` (its compose project name was directory-derived).
DB_CONTAINER=scheduler-db-1
DB_USER=scheduler
DB_NAME=scheduler_prod

RETENTION_HOURS=336

HEALTH_URL=https://<DOMAIN>/health

TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# WARNING: running this monitor on the SAME host it is protecting means it
# cannot alert you when the whole server is down — it can't SSH out to a
# dead box, and its cron won't run if the box is off. Pair it with a free
# external uptime check (e.g. UptimeRobot) hitting https://<DOMAIN>/health,
# or, better, run the monitor container on a separate machine entirely —
# it only ever needs outbound SSH access to the target server.
