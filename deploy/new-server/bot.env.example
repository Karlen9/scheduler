########################################################################
# WARNING — READ BEFORE EDITING
#
# In production, copy the REAL bot.env from the old server — do NOT fill
# in these placeholders manually.
#
# ENCRYPTION_KEY must NEVER change: it encrypts every specialist's
# Telegram bot token. Losing it or rotating it BRICKS every specialist
# bot on the platform (their tokens become undecryptable).
########################################################################

# Required
WEB_APP_URL=https://your-deployed-mini-app-url.com
PUBLIC_BASE_URL=https://<DOMAIN>
# SQLite path inside the container; /data must be a mounted volume. Ignored while
# DATABASE_URL is set (docker-compose.yml sets it, so Postgres is used).
DATABASE_PATH=/data/scheduler.db
PORT=8080

# NOTE: DATABASE_URL is intentionally NOT set here. docker-compose.yml's
# `environment:` block for the bot service injects it at container start,
# and compose `environment:` values always override values loaded from
# `env_file`. Setting a stale DATABASE_URL in this file would be harmless
# (it gets overridden) but is omitted to avoid confusion.

# Master bot for specialist onboarding (create via @BotFather)
MASTER_BOT_TOKEN=your-master-bot-token

# Admin (owner) Telegram IDs — unlock the master bot's admin analytics panel
# and topic-level replies inside the support supergroup.
ADMIN_IDS=[123456789,987654321]

# Bearer token for /superadmin/* endpoints and the owner dashboard proxy.
SUPERADMIN_SECRET=your-superadmin-bearer-secret

# Support supergroup (master bot's operator relay)
# 1. Create a Telegram supergroup and enable "Topics" in the group settings.
# 2. Add the master bot to the group as an admin with "Manage Topics" and "Send Messages" rights.
# 3. Post any message, forward it to @userinfobot, and copy the negative chat ID below
#    (format: -100XXXXXXXXXX). Leave unset to disable the operator relay.
SUPPORT_GROUP_ID=-1001234567890

# Optional
# Extra browser origins allowed by CORS, comma-separated. Added to WEB_APP_URL, which is always
# allowed. Wildcards ("*") and non-http(s) entries are rejected at startup with a log warning.
# CORS_ALLOWED_ORIGINS=https://dashboard.example.com,https://other.example.com
#
# LOAD_TEST_MODE: LOCAL ONLY. Bypasses Telegram auth for X-Test-User-ID and disables rate limits.
# The bot refuses to start unless PUBLIC_BASE_URL is localhost/127.0.0.1/::1. Never set in production.
# LOAD_TEST_MODE=true
# MASTER_WEBHOOK_SECRET=your-master-webhook-secret
# ENCRYPTION_KEY=your-encryption-key

# Legacy single-bot setup (optional - for development without master bot)
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# SPECIALIST_TELEGRAM_ID=123456789
# SPECIALIST_NAME=Your Name
