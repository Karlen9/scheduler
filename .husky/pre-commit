bunx lint-staged

# Run Go tests if any .go files are staged
if git diff --cached --name-only | grep -q '\.go$'; then
  echo "Running Go tests..."
  cd bot && go test ./... && cd ..
fi

# Run frontend tests related to staged files
STAGED_TS=$(git diff --cached --name-only | grep 'mini-app/src/.*\.\(ts\|tsx\)$' | sed 's|^mini-app/||')
if [ -n "$STAGED_TS" ]; then
  echo "Running frontend tests..."
  cd mini-app && bunx vitest related $STAGED_TS --run || exit 1
  cd ..
fi
