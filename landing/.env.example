# Canonical origin of this landing (used for metadata, sitemap and robots).
# On Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL, locally to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Origin of the mini-app deployment that hosts /privacy and /terms.
NEXT_PUBLIC_APP_URL=https://sport-app-orcin.vercel.app

# Public contact email. Leave empty to render no email anywhere.
NEXT_PUBLIC_CONTACT_EMAIL=
