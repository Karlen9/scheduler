# Required
WEB_APP_URL=https://your-deployed-mini-app-url.com
PUBLIC_BASE_URL=https://your-server-url.com
DATABASE_PATH=./data/scheduler.db
PORT=8080

# Master bot for trainer onboarding (create via @BotFather)
MASTER_BOT_TOKEN=your-master-bot-token

# Admin Telegram IDs (can use /trainers, /stats in master bot)
ADMIN_IDS=[123456789,987654321]

# Legacy single-bot setup (optional - for development without master bot)
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# TRAINER_TELEGRAM_ID=123456789
# TRAINER_NAME=Your Name
