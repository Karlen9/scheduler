# Required
WEB_APP_URL=https://your-deployed-mini-app-url.com
PUBLIC_BASE_URL=https://your-server-url.com
# Local dev SQLite file. Containers must use DATABASE_PATH=/data/scheduler.db on a mounted
# volume (the image defaults to it), otherwise the database is lost when the container is
# recreated. When DATABASE_URL is set it takes precedence and DATABASE_PATH is ignored.
DATABASE_PATH=./data/scheduler.db
PORT=8080

# Master bot for specialist onboarding (create via @BotFather)
MASTER_BOT_TOKEN=your-master-bot-token

# Admin (owner) Telegram IDs — unlock the master bot's admin analytics panel
# and topic-level replies inside the support supergroup.
ADMIN_IDS=[123456789,987654321]

# Bearer token for /superadmin/* endpoints and the owner dashboard proxy.
SUPERADMIN_SECRET=your-superadmin-bearer-secret

# Support supergroup (master bot's operator relay)
# 1. Create a Telegram supergroup and enable "Topics" in the group settings.
# 2. Add the master bot to the group as an admin with "Manage Topics" and "Send Messages" rights.
# 3. Post any message, forward it to @userinfobot, and copy the negative chat ID below
#    (format: -100XXXXXXXXXX). Leave unset to disable the operator relay.
SUPPORT_GROUP_ID=-1001234567890

# Optional: extra browser origins allowed by CORS, comma-separated. Added to WEB_APP_URL, which
# is always allowed. Wildcards ("*") and non-http(s) entries are rejected with a log warning.
# CORS_ALLOWED_ORIGINS=https://dashboard.example.com

# Optional, LOCAL ONLY: bypasses Telegram auth for X-Test-User-ID and disables rate limits.
# Startup fails unless PUBLIC_BASE_URL is localhost/127.0.0.1/::1.
# LOAD_TEST_MODE=true

# Legacy single-bot setup (optional - for development without master bot)
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# SPECIALIST_TELEGRAM_ID=123456789
# SPECIALIST_NAME=Your Name
